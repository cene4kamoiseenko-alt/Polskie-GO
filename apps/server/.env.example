# Postgres
DATABASE_URL=postgresql://polski:polski@localhost:5432/polskigo
# Тестова БД (використовується vitest)
TEST_DATABASE_URL=postgresql://polski:polski@localhost:5432/polskigo_test

PORT=3000
NODE_ENV=development
# Публічна адреса Mini App (HTTPS) — для кнопки бота та посилань-запрошень
WEB_APP_URL=http://localhost:5173
# Дозволені origin для CORS (через кому)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Секрет для підпису сесійних токенів (довгий випадковий рядок)
SESSION_SECRET=change-me-to-a-long-random-string

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=polski_go_bot
# Секрет для перевірки webhook (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# Коротка назва Mini App у BotFather (для посилань t.me/<bot>/<app>?startapp=...)
TELEGRAM_APP_SHORT_NAME=app

# Режим розробки: вхід без Telegram (НІКОЛИ не вмикати в production)
DEV_AUTH=true

# Перший адміністратор (створюється при seed)
ADMIN_EMAIL=admin@polski.go
ADMIN_PASSWORD=change-me-admin

# AI-викладач (Anthropic Claude). Без ключа AI-вкладка працює в обмеженому режимі.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Місячний бюджет вихідних токенів на всіх користувачів
AI_MONTHLY_OUTPUT_TOKENS=5000000

# Фонові задачі (нагадування)
JOBS_ENABLED=false
