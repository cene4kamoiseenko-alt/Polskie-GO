{
  "name": "@polski-go/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c ../../wrangler.jsonc --port 8787 --test-scheduled",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed:sql": "node --import tsx scripts/build-seed.ts",
    "seed:sql:force": "node --import tsx scripts/build-seed.ts --force",
    "db:local": "node --import tsx scripts/build-seed.ts && wrangler d1 migrations apply polski-go --local -c ../../wrangler.jsonc && wrangler d1 execute polski-go --local -c ../../wrangler.jsonc --file seed.sql --yes",
    "bot:setup": "node --env-file-if-exists=.env scripts/setup-bot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@polski-go/shared": "0.1.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.10.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "22.20.5",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.152.0"
  }
}
