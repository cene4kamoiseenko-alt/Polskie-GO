// POLSKI GO на Cloudflare Workers (безкоштовний план):
//  • Worker (apps/server) — API, webhook бота, cron-нагадування;
//  • Static Assets — зібрані Mini App і адмінка (dist-cf);
//  • D1 — база даних, KV — файли, завантажені в адмінці.
// Бази D1 і KV створюються автоматично під час першого `wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polski-go",
  "main": "apps/server/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*", "/uploads/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polski-go",
      "migrations_dir": "apps/server/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "UPLOADS" }],
  // Нагадування та розсилки — кожні 15 хвилин.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Несекретні налаштування. Секрети (TELEGRAM_BOT_TOKEN, SESSION_SECRET, ...) — у панелі Cloudflare.
  "vars": { "ENVIRONMENT": "production" },
  "keep_vars": true
}
