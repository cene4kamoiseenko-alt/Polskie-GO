// POLSKI GO на Cloudflare Workers (безкоштовний план):
//  • Worker (apps/server) — API, webhook бота, cron-нагадування;
//  • Static Assets — зібрані Mini App і адмінка (dist-cf);
//  • D1 — база даних (і файли, завантажені в адмінці).
// База D1 створюється автоматично під час першого `wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polskie-go",
  "main": "apps/server/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Smart Placement: запит з D1 робить кілька звернень до бази, тож Worker запускається поруч із нею, а не біля
  // користувача (статичні файли все одно віддаються з найближчого дата-центру). Перевірка: /api/health → edge.
  "placement": { "mode": "smart" },
  // Менший скрипт — швидший холодний старт ізоляту.
  "minify": true,
  // Публічна адреса https://polskie-go.<акаунт>.workers.dev (її відкриває Telegram).
  "workers_dev": true,
  "assets": {
    "directory": "dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*", "/uploads/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polski-go",
      "migrations_dir": "apps/server/migrations"
    }
  ],
  // Аудіобібліотека (docs/AUDIO_LIBRARY_RU.md): додається після того, як власник увімкне R2 і створить бакет polski-go-audio —
  // без бакета виклад упаде. Тоді: "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "polski-go-audio" }]
  // Нагадування та розсилки — кожні 15 хвилин.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Несекретні налаштування. Секрети (TELEGRAM_BOT_TOKEN, SESSION_SECRET, ...) — у панелі Cloudflare.
  "vars": { "ENVIRONMENT": "production" },
  "keep_vars": true
}
